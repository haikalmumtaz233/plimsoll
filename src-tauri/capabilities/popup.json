{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "popup",
  "description": "Minimal permissions for the tray popup window",
  "windows": ["popup"],
  "permissions": [
    "core:app:allow-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-usage-summary",
    "allow-refresh-now",
    "allow-open-login",
    "allow-set-cli-fallback",
    "allow-open-usage-page",
    "allow-set-accurate-mode",
    "allow-set-preferences",
    "allow-set-manual-percent",
    "allow-set-autostart",
    "allow-hide-popup"
  ]
}
